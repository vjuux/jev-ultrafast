TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Local decisions, no TypeSafe key (scripts/local.sh sets these): a laya-browser server on this machine.
# TYPESAFE_BASE_URL=http://127.0.0.1:8791
# TYPESAFE_API_KEY=local
# OpenAI works as the text model too: TEXT_MODEL_BASE_URL=https://api.openai.com/v1, TEXT_MODEL=gpt-4.1-mini,
# TEXT_MODEL_EXTRA_JSON={}   (sends no reasoning field; OpenAI rejects OpenRouter's)
